[Unit]
Description=z0 Platform API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zo
Group=zo
WorkingDirectory=/home/zo/projects/z0
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/zo/projects/z0/.venv/bin/z0-platform api --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

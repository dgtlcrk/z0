[Unit]
Description=z0 Platform Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zo
Group=zo
WorkingDirectory=/home/zo/projects/z0
Environment=HOME=/home/zo
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/zo/projects/z0/.venv/bin/z0-platform jobs daemon --poll 5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

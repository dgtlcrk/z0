# Copy to terraform.tfvars after choosing an approved IRC deployment target.
# Default false prevents starting the container with plaintext IRC.
enable_bot = false
irc_server  = "REPLACE_WITH_APPROVED_IRC_SERVER"
irc_channel = "#REPLACE_WITH_APPROVED_CHANNEL"
irc_port    = 6697
irc_nick    = "z0_cloud_01"

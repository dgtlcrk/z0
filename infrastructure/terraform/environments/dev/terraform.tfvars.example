# Copy to terraform.tfvars after choosing an approved IRC deployment target.
# Default false prevents starting the container with plaintext IRC.
enable_bot = false
irc_server  = "irc.prison.net"
irc_channel = "#skipland"
irc_port    = 6697
irc_nick    = "z0_cloud_01"
# irc_op_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:your-secret"
# Mandatory before enable_bot=true: certificate confirmed out-of-band
# irc_tls_ca_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:z0/irc/tls-ca-XXXXXX"
